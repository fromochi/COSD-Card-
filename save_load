class_name SaveLoad
extends RefCounted
## 存档：卡库预设 + 当前对局，存到 user://cardgame_save.cfg（文本格式可直接改）

const PATH := "user://cardgame_save.cfg"

static func save_all(gs: Node) -> void:
	var cfg := ConfigFile.new()
	# 小类型库
	for lib in CardData.libraries.keys():
		var arr := []
		for c in CardData.libraries[lib]:
			arr.append({"id": c.id, "name": c.name, "value": c.value, "desc": c.desc, "art": c.art})
		cfg.set_value("lib", String(lib), arr)
	# 大牌库
	for pid in CardData.pools.keys():
		cfg.set_value("pool", String(pid), CardData.pools[pid])
	# 对局
	cfg.set_value("game", "num_players", gs.num_players)
	cfg.set_value("game", "names", gs.player_names)
	cfg.set_value("game", "round_no", gs.round_no)
	cfg.set_value("game", "phase", gs.phase)
	cfg.set_value("game", "players", gs.players)
	cfg.set_value("game", "deck", gs.deck)
	cfg.set_value("game", "logs", gs.logs.slice(maxi(0, gs.logs.size() - 200), gs.logs.size()))
	cfg.save(PATH)

static func load_all(gs: Node) -> bool:
	var cfg := ConfigFile.new()
	if cfg.load(PATH) != OK:
		return false
	for lib in CardData.libraries.keys():
		if not cfg.has_section_key("lib", String(lib)):
			continue
		var arr: Array = cfg.get_value("lib", String(lib), [])
		var out := []
		for c in arr:
			out.append({"id": String(c.id), "name": String(c.name), "type": int(lib),
				"value": int(c.value), "desc": String(c.desc), "art": String(c.art)})
		CardData.libraries[lib] = out
	for pid in CardData.pools.keys():
		if cfg.has_section_key("pool", String(pid)):
			var p := []
			for e in cfg.get_value("pool", String(pid), []):
				p.append([int(e[0]), String(e[1]), int(e[2])])
			CardData.pools[pid] = p
	if not cfg.has_section_key("game", "num_players"):
		return true
	gs.num_players = int(cfg.get_value("game", "num_players", 8))
	var names: Array = cfg.get_value("game", "names", [])
	gs.player_names.clear()
	for n in names:
		gs.player_names.append(String(n))
	gs.players.clear()
	for p in cfg.get_value("game", "players", []):
		gs.players.append({
			"name": String(p.name), "role": String(p.role),
			"a": int(p.a), "b": int(p.b),
			"hand": _conv(p.hand), "table": _conv(p.table),
			"played": _conv(p.played), "discard": _conv(p.discard),
		})
	gs.deck = _conv(cfg.get_value("game", "deck", []))
	gs.round_no = int(cfg.get_value("game", "round_no", 1))
	gs.phase = int(cfg.get_value("game", "phase", 1))
	gs.logs.clear()
	for l in cfg.get_value("game", "logs", []):
		gs.logs.append(String(l))
	return true

static func _conv(arr) -> Array:
	var out := []
	for c in arr:
		out.append([int(c[0]), String(c[1])])
	return out
