class_name UIKit
extends RefCounted
## 共用 UI 构件：卡通风格面板、按钮、数值条、卡牌框（支持贴图）

const BG := Color(0.07, 0.09, 0.16)
const PANEL := Color(0.13, 0.16, 0.26)
const PANEL2 := Color(0.18, 0.22, 0.34)
const LINE := Color(0.35, 0.42, 0.62)
const GOLD := Color(1.0, 0.84, 0.42)
const TEXT := Color(0.92, 0.94, 0.99)
const SUB := Color(0.66, 0.72, 0.85)
const RED := Color(1.0, 0.45, 0.5)
const GREEN := Color(0.45, 0.9, 0.62)
const BLUE := Color(0.42, 0.72, 1.0)

const LIB_COLOR := {
	0: Color(0.55, 0.6, 0.7), 1: Color(0.45, 0.8, 0.95), 2: Color(0.6, 0.85, 0.55),
	3: Color(1.0, 0.82, 0.4), 4: Color(0.8, 0.6, 1.0), 5: Color(1.0, 0.55, 0.55),
	6: Color(0.5, 0.95, 0.85), 7: Color(0.6, 0.7, 0.95),
}

static func style(bg: Color, border: Color, w: int = 2, r: int = 10) -> StyleBoxFlat:
	var s := StyleBoxFlat.new()
	s.bg_color = bg
	s.border_color = border
	s.set_border_width_all(w)
	s.set_corner_radius_all(r)
	s.content_margin_left = 10
	s.content_margin_right = 10
	s.content_margin_top = 8
	s.content_margin_bottom = 8
	return s

static func panel(bg: Color = PANEL, border: Color = LINE) -> PanelContainer:
	var p := PanelContainer.new()
	p.add_theme_stylebox_override("panel", style(bg, border))
	return p

static func label(t: String, size: int = 16, c: Color = TEXT) -> Label:
	var l := Label.new()
	l.text = t
	l.add_theme_font_size_override("font_size", size)
	l.add_theme_color_override("font_color", c)
	return l

static func button(t: String, bg: Color = PANEL2, c: Color = TEXT) -> Button:
	var b := Button.new()
	b.text = t
	b.add_theme_stylebox_override("normal", style(bg, LINE))
	b.add_theme_stylebox_override("hover", style(bg.lightened(0.15), GOLD))
	b.add_theme_stylebox_override("pressed", style(GOLD.darkened(0.35), GOLD))
	b.add_theme_color_override("font_color", c)
	b.add_theme_color_override("font_hover_color", GOLD)
	return b

static func bar(value: int, maximum: int, color: Color, title: String) -> VBoxContainer:
	var box := VBoxContainer.new()
	box.add_child(label("%s   %d / %d" % [title, value, maximum], 15, color))
	var pb := ProgressBar.new()
	pb.max_value = maximum
	pb.value = value
	pb.custom_minimum_size = Vector2(0, 20)
	pb.show_percentage = false
	pb.add_theme_stylebox_override("background", style(Color(0.05, 0.06, 0.1), Color(0.25, 0.3, 0.45), 1, 6))
	var f := style(color.darkened(0.25), color.lightened(0.2), 1, 6)
	pb.add_theme_stylebox_override("fill", f)
	box.add_child(pb)
	return box

## 带皮肤底的卡牌框：有贴图显示贴图，没有显示类型色块 + 名字
static func card_frame(lib: int, card: Dictionary, w: int, h: int) -> PanelContainer:
	var p := panel(PANEL2, LIB_COLOR.get(lib, LINE))
	p.custom_minimum_size = Vector2(w, h)
	p.mouse_filter = Control.MOUSE_FILTER_IGNORE
	var vb := VBoxContainer.new()
	vb.mouse_filter = Control.MOUSE_FILTER_IGNORE
	vb.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	vb.size_flags_vertical = Control.SIZE_EXPAND_FILL
	p.add_child(vb)
	var art_path: String = card.get("art", "")
	var tex: Texture2D = null
	if art_path != "" and ResourceLoader.exists(art_path):
		tex = load(art_path)
	if tex:
		var tr := TextureRect.new()
		tr.texture = tex
		tr.expand_mode = TextureRect.EXPAND_IGNORE_SIZE
		tr.stretch_mode = TextureRect.STRETCH_KEEP_ASPECT_CENTERED
		tr.size_flags_vertical = Control.SIZE_EXPAND_FILL
		tr.mouse_filter = Control.MOUSE_FILTER_IGNORE
		vb.add_child(tr)
	else:
		var ph := Panel.new()
		ph.size_flags_vertical = Control.SIZE_EXPAND_FILL
		ph.mouse_filter = Control.MOUSE_FILTER_IGNORE
		ph.add_theme_stylebox_override("panel", style(LIB_COLOR.get(lib, LINE).darkened(0.6), Color(0, 0, 0, 0), 0, 6))
		var phl := label("暂无贴图", 12, SUB)
		phl.position = Vector2(6, 4)
		phl.size = Vector2(60, 20)

		ph.add_child(phl)
		vb.add_child(ph)
	var foot := HBoxContainer.new()
	foot.mouse_filter = Control.MOUSE_FILTER_IGNORE
	foot.add_child(label(card.get("name", "?"), 12, GOLD))
	foot.add_child(label("  %d" % int(card.get("value", 0)), 12, BLUE))
	vb.add_child(foot)
	return p

static func scroll(child: Control) -> ScrollContainer:
	var s := ScrollContainer.new()
	s.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	s.size_flags_vertical = Control.SIZE_EXPAND_FILL
	s.horizontal_scroll_mode = ScrollContainer.SCROLL_MODE_DISABLED
	child.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	s.add_child(child)
	return s
